GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_BASE_DIR=../knowledge_base
TOP_K=5
SIMILARITY_THRESHOLD=0.30
